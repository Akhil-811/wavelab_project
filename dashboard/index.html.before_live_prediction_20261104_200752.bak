<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>WaveLab | Surrogate Research Studio</title>
<style>
:root{--bg:#07111f;--panel:#101e31;--panel2:#13253a;--line:#233951;--text:#eaf2fb;--muted:#91a8c1;--cyan:#45d7e8;--blue:#6295ff;--violet:#b38aff;--green:#59dfa9;--orange:#ffbd69;--red:#ff7188;--shadow:0 16px 40px #0003}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 75% -15%,#17395c 0,transparent 36%),var(--bg);color:var(--text);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select{font:inherit}button{cursor:pointer}.shell{display:grid;grid-template-columns:250px 1fr;min-height:100vh}.sidebar{border-right:1px solid var(--line);background:#081523dd;padding:22px 14px;position:sticky;top:0;height:100vh;overflow:auto}.brand{display:flex;gap:11px;align-items:center;padding:4px 10px 26px}.logo{width:40px;height:40px;border-radius:13px;background:linear-gradient(135deg,var(--cyan),var(--blue) 60%,var(--violet));display:grid;place-items:center;color:#07111f;font-size:21px;font-weight:900;box-shadow:0 8px 25px #45d7e833}.brand b{display:block;font-size:16px;letter-spacing:.3px}.brand small{color:var(--muted)}.nav-label{font-size:10px;letter-spacing:1.6px;color:#607b98;font-weight:800;padding:14px 12px 7px}.nav{display:flex;align-items:center;gap:11px;width:100%;border:0;background:transparent;color:#9fb4cb;text-align:left;padding:11px 12px;border-radius:10px;margin:2px 0}.nav:hover,.nav.active{background:linear-gradient(90deg,#183a55,#152c45);color:white}.nav.active{box-shadow:inset 3px 0 var(--cyan)}.nav .ico{width:19px;text-align:center;font-size:16px}.sidebar-foot{margin:24px 8px 0;padding:13px;border:1px solid var(--line);border-radius:12px;color:var(--muted);font-size:11px}.statusdot{display:inline-block;width:7px;height:7px;background:var(--green);border-radius:50%;margin-right:6px}.main{min-width:0;padding:26px clamp(16px,3vw,42px) 48px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.eyebrow{color:var(--cyan);font-size:10px;letter-spacing:1.8px;font-weight:800;text-transform:uppercase}.h1{font-size:clamp(26px,3vw,38px);letter-spacing:-1.3px;line-height:1.13;margin:7px 0 8px}.sub{color:var(--muted);max-width:800px}.top-actions{display:flex;gap:8px;flex-wrap:wrap}.btn{border:1px solid #35516d;background:#13283e;color:var(--text);padding:9px 13px;border-radius:9px;font-weight:650;font-size:12px}.btn:hover{border-color:var(--cyan);transform:translateY(-1px)}.btn.primary{background:linear-gradient(120deg,#38bfd4,#5b8eff);color:#061321;border:0}.btn.warn{border-color:#805b32;color:#ffd39a}.pill{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);padding:5px 9px;border-radius:99px;font-size:11px;color:#bad0e4;background:#0d1b2b}.grid{display:grid;gap:14px}.kpis{grid-template-columns:repeat(4,minmax(0,1fr));margin:20px 0}.card{background:linear-gradient(145deg,#122238,#0e1b2d);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:var(--shadow);min-width:0}.kpi-label{color:var(--muted);font-size:12px}.kpi-value{font-size:27px;font-weight:780;letter-spacing:-.7px;margin:8px 0 2px}.kpi-foot{font-size:11px;color:#7f9ab5}.up{color:var(--green)}.down{color:var(--orange)}.two{grid-template-columns:1.25fr .75fr}.three{grid-template-columns:repeat(3,minmax(0,1fr))}.section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}.section-head h2{font-size:16px;margin:0 0 4px}.section-head p{color:var(--muted);margin:0;font-size:12px}.chart{width:100%;min-height:270px}.chart svg{width:100%;height:auto;overflow:visible}.legend{display:flex;gap:13px;flex-wrap:wrap;color:var(--muted);font-size:11px;margin-top:8px}.legend span{display:inline-flex;align-items:center;gap:6px}.swatch{width:9px;height:9px;border-radius:3px;display:inline-block}.filters{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.select,.textinput{background:#091726;color:var(--text);border:1px solid #2b4560;border-radius:8px;padding:8px 10px;min-width:120px}.tablewrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:12px}th{text-align:left;color:#8ea8c1;font-weight:650;background:#0b1929}th,td{padding:11px 10px;border-bottom:1px solid #20364d;white-space:nowrap}tbody tr:hover{background:#152a40}.best{color:var(--green);font-weight:750}.metricbar{height:7px;background:#21354a;border-radius:9px;overflow:hidden;margin-top:7px}.metricbar i{display:block;height:100%;border-radius:9px}.note{border:1px solid #28566a;background:#0d2937;border-radius:12px;padding:13px 15px;color:#c7eaf0;font-size:12px}.warning{border-color:#75562d;background:#2a2117;color:#ffe0ad}.muted{color:var(--muted)}.page{display:none}.page.active{display:block;animation:fade .2s ease}@keyframes fade{from{opacity:.6;transform:translateY(3px)}to{opacity:1;transform:none}}.hero{background:linear-gradient(120deg,#143450,#172645 65%,#28234a);border:1px solid #2c4d6d;border-radius:18px;padding:24px;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:240px;height:240px;border:1px solid #4bd5e822;border-radius:50%;right:-60px;top:-100px;box-shadow:0 0 0 25px #4bd5e808,0 0 0 55px #4bd5e805}.hero h2{font-size:24px;line-height:1.2;margin:8px 0}.hero p{color:#b8cee1;max-width:760px}.hero .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:17px}.mini-title{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1.2px;font-weight:800}.phase{display:grid;grid-template-columns:40px 1fr;gap:12px;padding:15px 0;border-bottom:1px solid #20364d}.phase:last-child{border-bottom:0}.phase-num{width:35px;height:35px;border-radius:11px;background:#183953;color:var(--cyan);display:grid;place-items:center;font-weight:800}.phase h3{margin:0 0 4px;font-size:14px}.phase p{margin:0;color:var(--muted);font-size:12px}.tag{display:inline-block;font-size:10px;padding:3px 7px;border-radius:6px;background:#1d344b;color:#a9c9e6;margin:2px}.tag.real{color:#85efc5;background:#113b35}.tag.todo{color:#ffd38e;background:#3d2b18}.model-card{border-top:3px solid var(--blue)}.model-card:nth-child(2){border-top-color:var(--cyan)}.model-card:nth-child(3){border-top-color:var(--violet)}.model-card h3{margin:5px 0}.model-card p{color:var(--muted);font-size:12px}.formula{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;background:#091725;border:1px solid #203a53;border-radius:8px;padding:10px;font-size:12px;color:#c5e9f2;overflow:auto}.control-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field{display:flex;flex-direction:column;gap:6px;margin:10px 0}.field label{color:#a9bfd5;font-size:12px}.field select,.field input{width:100%}.runstatus{padding:13px;border-radius:10px;background:#0a1827;border:1px solid #28415a;color:#b3c7dc;font-size:12px;min-height:50px}.progress{height:6px;background:#22364b;border-radius:9px;overflow:hidden;margin:10px 0}.progress i{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--cyan),var(--violet));transition:width .3s}.footer{color:#6f88a3;font-size:10px;text-align:center;padding:25px 0}.toast{position:fixed;right:20px;bottom:20px;background:#16394a;border:1px solid #3b8091;border-radius:12px;padding:12px 16px;box-shadow:var(--shadow);display:none;z-index:10}.empty{border:1px dashed #39536c;border-radius:12px;padding:20px;text-align:center;color:var(--muted)}.small{font-size:11px}.timeline{display:grid;grid-template-columns:repeat(8,minmax(100px,1fr));gap:7px;overflow:auto;padding:3px 0 10px}.timeline button{min-width:100px;text-align:left;border:1px solid #29435b;background:#0d1b2b;color:#dce8f5;border-radius:10px;padding:11px}.timeline button.active{border-color:var(--cyan);background:#143448}.timeline b{display:block;color:var(--cyan);font-size:10px}.timeline span{font-size:11px}.hidden{display:none!important}
@media(max-width:1050px){.shell{grid-template-columns:205px 1fr}.kpis{grid-template-columns:repeat(2,1fr)}.two{grid-template-columns:1fr}.three{grid-template-columns:1fr 1fr}}
@media(max-width:720px){.shell{display:block}.sidebar{position:relative;height:auto;padding:10px;border-right:0;border-bottom:1px solid var(--line)}.brand{padding:5px 7px 10px}.nav-label,.sidebar-foot{display:none}.navlist{display:flex;overflow:auto;gap:4px}.nav{white-space:nowrap;width:auto;padding:9px}.main{padding:20px 13px}.topbar{align-items:flex-start;flex-direction:column}.kpis{gap:9px}.kpi-value{font-size:23px}.three,.control-grid{grid-template-columns:1fr}.hero{padding:18px}.section-head{flex-direction:column}.timeline{grid-template-columns:repeat(8,110px)}}
</style></head>
<body>
<div class="shell">
<aside class="sidebar">
 <div class="brand"><div class="logo">W</div><div><b>WaveLab</b><small>Surrogate Research Studio</small></div></div>
 <div class="nav-label">RESEARCH WORKSPACE</div>
 <div class="navlist">
  <button class="nav active" data-page="overview"><span class="ico">◈</span>Overview</button>
  <button class="nav" data-page="datasets"><span class="ico">▦</span>Dataset explorer</button>
  <button class="nav" data-page="method"><span class="ico">⌘</span>Methodology</button>
  <button class="nav" data-page="models"><span class="ico">◎</span>Model laboratory</button>
  <button class="nav" data-page="results"><span class="ico">▥</span>Results & comparison</button>
  <button class="nav" data-page="validation"><span class="ico">✓</span>Validation & tests</button>
  <button class="nav" data-page="experiments"><span class="ico">▶</span>Experiment controls</button>
  <button class="nav" data-page="conclusions"><span class="ico">✦</span>Research conclusions</button>
 </div>
 <div class="sidebar-foot"><div><span class="statusdot" id="sidebarStatusDot"></span><b id="sidebarStatusTitle" style="color:#d9e9f7">Results loaded</b></div><div style="margin-top:6px">36 seeded metric records<br>Seeds 21 · 42 · 123</div><div id="sidebarBackendText" style="margin-top:9px;color:#6e89a3">Checking local backend…</div></div>
</aside>
<main class="main">
<header class="topbar"><div><div class="eyebrow">Research workspace / COMP5064</div><h1 class="h1" id="pageTitle">Research overview</h1><div class="sub" id="pageSub">Spatially-aware neural surrogate modelling for large-scale wave energy farms.</div></div><div class="top-actions"><button class="btn" id="exportCsv">↧ Export metrics CSV</button><button class="btn primary" onclick="go('experiments')">▶ Experiment controls</button></div></header>

<section class="page active" id="page-overview">
 <div class="hero"><div class="eyebrow">Research question</div><h2>Can spatial information improve<br>farm-level wave power prediction?</h2><p>Compare a coordinate-only MLP, a spatial-feature MLP and a graph neural network (GNN) using four WEC farm datasets, a fixed grouped split and three training seeds.</p><div class="chips"><span class="pill">4 dataset variants</span><span class="pill">3 model families</span><span class="pill">36 seeded runs</span><span class="pill">Grouped split · seed 42</span></div></div>
 <div class="grid kpis">
  <div class="card"><div class="kpi-label">Dataset variants</div><div class="kpi-value">04</div><div class="kpi-foot">Perth / Sydney · 49 / 100 WECs</div></div>
  <div class="card"><div class="kpi-label">Seeded evaluations</div><div class="kpi-value">36</div><div class="kpi-foot">3 architectures × 4 datasets × 3 seeds</div></div>
  <div class="card"><div class="kpi-label">Best mean MAE reduction</div><div class="kpi-value up" id="bestReduction">—</div><div class="kpi-foot">Versus coordinate-only baseline</div></div>
  <div class="card"><div class="kpi-label">Best overall model pattern</div><div class="kpi-value" id="bestModelPattern" style="font-size:20px">Loading…</div><div class="kpi-foot" id="bestModelPatternFoot">Calculated from loaded benchmark records</div></div>
 </div>
 <div class="grid two">
  <div class="card"><div class="section-head"><div><h2>Mean test MAE by dataset</h2><p>Lower is better · mean across seeds with SD in tooltip</p></div><span class="pill">MAE</span></div><div class="chart" id="overviewMae"></div><div class="legend" id="modelLegend"></div></div>
  <div class="card"><div class="section-head"><div><h2>Research workflow</h2><p>From raw coordinates to evidence-backed conclusions</p></div><span class="pill">8 phases</span></div><div id="phaseSummary"></div><button class="btn" onclick="go('method')">Explore full methodology →</button></div>
 </div>
 <div class="note" style="margin-top:14px">Evidence boundary: final metrics and recorded dataset-audit findings are available. Detailed epoch histories, per-sample predictions, and actual experiment launching require the project source files and a connected backend.</div>
</section>

<section class="page" id="page-datasets">
 <div class="grid kpis">
  <div class="card"><div class="kpi-label">Farm configurations</div><div class="kpi-value">Perth + Sydney</div><div class="kpi-foot">Two locations represented</div></div>
  <div class="card"><div class="kpi-label">Farm sizes</div><div class="kpi-value">49 / 100</div><div class="kpi-foot">WECs per farm configuration</div></div>
  <div class="card"><div class="kpi-label">Source</div><div class="kpi-value" style="font-size:17px">UCI ML Repository</div><div class="kpi-foot">Dataset ID 882 · DOI 10.24432/C5GG7Q</div></div>
  <div class="card"><div class="kpi-label">Primary target</div><div class="kpi-value" style="font-size:19px">Total_Power</div><div class="kpi-foot">Farm-level total power prediction</div></div>
 </div>
 <div class="grid two">
  <div class="card"><div class="section-head"><div><h2>Dataset selection</h2><p>Choose a variant to view available experiment evidence.</p></div></div><div class="field"><label>Dataset</label><select id="datasetSelect" class="select"><option>Perth 49</option><option>Perth 100</option><option>Sydney 49</option><option>Sydney 100</option></select></div><div id="datasetDetails"></div></div>
  <div class="card"><div class="section-head"><div><h2>Farm geometry concept</h2><p>Illustrative coordinate layout, not a recovered source layout.</p></div></div><div id="geometryViz" class="chart"></div><div class="small muted">This panel illustrates the coordinate-based modelling idea only. It is not a plot of actual WEC coordinates.</div></div>
 </div>
 <div class="card" style="margin-top:14px"><div class="section-head"><div><h2>Data quality and leakage audit</h2><p>Findings retained from the recorded project inspection.</p></div><span class="pill">Audit notes</span></div><div class="grid three">
  <div><span class="tag real">Observed</span><h3>Repeated layouts</h3><p class="muted small">Perth 49 inspection reported 36,043 rows and 25,107 exact duplicate rows, with 10,218 unique layouts.</p></div>
  <div><span class="tag real">Observed</span><h3>Conflicting targets</h3><p class="muted small">The inspection found layouts with conflicting target values, including cases where layout and qW were not enough to uniquely determine the target.</p></div>
  <div><span class="tag todo">Guardrail</span><h3>Prevent leakage</h3><p class="muted small">Exclude Power1…Power49/Power100 and qW from primary coordinate-only/spatial-only inputs. Individual power columns directly contribute to Total_Power.</p></div>
 </div></div>
</section>

<section class="page" id="page-method">
 <div class="card"><div class="section-head"><div><h2>End-to-end research procedure</h2><p>Select a phase to inspect its purpose, outputs and evidence status.</p></div><span class="pill">Methodology map</span></div><div class="timeline" id="timeline"></div><div id="phaseDetail" style="margin-top:12px"></div></div>
 <div class="grid two" style="margin-top:14px">
  <div class="card"><h2>Split strategy</h2><p class="muted">Layouts are grouped so identical layouts do not cross train, validation and test boundaries. Split seed remains fixed while model/training seeds vary.</p><div class="formula">split_seed = 42<br>training_seeds = [21, 42, 123]</div><div class="note" style="margin-top:12px">Why it matters: random row-level splitting can leak repeated layouts into evaluation and make test performance look overly optimistic.</div></div>
  <div class="card"><h2>Input and target discipline</h2><p class="muted">The primary experiment predicts farm-level total power from coordinate-derived inputs.</p><div class="formula">Inputs: (x, y) coordinates<br>Spatial MLP: coordinates + geometric descriptors<br>GNN: nodes + neighbour edges<br>Target: Total_Power</div><p class="small muted">NMAE = test MAE ÷ mean absolute Total_Power on that run’s held-out test set. Target scaling is fitted on training data only.</p></div>
 </div>
</section>

<section class="page" id="page-models">
 <div class="grid three">
  <div class="card model-card"><span class="tag">Baseline</span><h3>Coordinate-only MLP</h3><p>Feeds flattened WEC coordinates to a feed-forward network. Establishes baseline predictive performance.</p><div class="formula">Input: 2 × N coordinates<br>49 WEC → 98 features<br>100 WEC → 200 features</div><p><b>Strength</b> <span class="muted">Simple reference model.</span></p><p><b>Trade-off</b> <span class="muted">Spatial relationships are implicit.</span></p></div>
  <div class="card model-card"><span class="tag" style="color:#6ce5ed">Spatial features</span><h3>Spatial-feature MLP</h3><p>Adds coordinate-derived local neighbour distances and global geometry descriptors.</p><div class="formula">Raw coordinates +<br>1st, 3rd, 5th neighbour distances<br>+ 7 global geometry statistics</div><p><b>Strength</b> <span class="muted" id="spatialStrength">Calculated from loaded benchmark records.</span></p><p><b>Trade-off</b> <span class="muted">Depends on hand-designed descriptors.</span></p></div>
  <div class="card model-card"><span class="tag" style="color:#c8a7ff">Graph model</span><h3>Graph neural network</h3><p>Represents each WEC as a node, uses symmetrized 8-nearest-neighbour edges, graph convolution and graph-level pooling.</p><div class="formula">Node: x, y<br>Edges: symmetrized 8-NN<br>3 graph-convolution layers<br>Mean + max pooling → readout</div><p><b>Strength</b> <span class="muted" id="gnnStrength">Calculated from loaded benchmark records.</span></p><p><b>Trade-off</b> <span class="muted">More complex; timing needs care.</span></p></div>
 </div>
 <div class="card" style="margin-top:14px"><div class="section-head"><div><h2>Model comparison</h2><p>Mean test metrics aggregated across seeds.</p></div><div class="filters"><select class="select" id="modelDataset"><option>Perth 49</option><option>Perth 100</option><option>Sydney 49</option><option>Sydney 100</option></select><select class="select" id="modelMetric"><option value="MAE">MAE</option><option value="RMSE">RMSE</option><option value="NMAE">NMAE</option><option value="R2">R²</option></select></div></div><div id="modelChart" class="chart"></div></div>
</section>

<section class="page" id="page-results">
 <div class="card"><div class="section-head"><div><h2>Interactive model benchmark</h2><p>Choose dataset and metric. Values use actual uploaded seed result JSONs.</p></div><div class="filters"><select class="select" id="resultDataset"><option>Perth 49</option><option>Perth 100</option><option>Sydney 49</option><option>Sydney 100</option></select><select class="select" id="resultMetric"><option value="MAE">MAE ↓</option><option value="RMSE">RMSE ↓</option><option value="NMAE">NMAE ↓</option><option value="R2">R² ↑</option></select></div></div><div id="resultChart" class="chart"></div><div class="legend" id="resultLegend"></div></div>
 <div class="grid two" style="margin-top:14px"><div class="card"><div class="section-head"><div><h2>Seed stability</h2><p>Inspect individual training seeds for selected model and dataset.</p></div></div><div class="filters"><select class="select" id="seedDataset"><option>Perth 49</option><option>Perth 100</option><option>Sydney 49</option><option>Sydney 100</option></select><select class="select" id="seedModel"><option>Coordinate MLP</option><option>Spatial-feature MLP</option><option>GNN</option></select></div><div id="seedChart" class="chart"></div></div><div class="card"><div class="section-head"><div><h2>Baseline improvement</h2><p>MAE reduction against coordinate-only MLP.</p></div></div><div id="improvement"></div></div></div>
 <div class="card" style="margin-top:14px"><div class="section-head"><div><h2>All seeded test results</h2><p>36 records · sorted and filterable by dataset/model/seed.</p></div><div class="filters"><select class="select" id="tableDataset"><option value="all">All datasets</option><option>Perth 49</option><option>Perth 100</option><option>Sydney 49</option><option>Sydney 100</option></select><select class="select" id="tableModel"><option value="all">All models</option><option>Coordinate MLP</option><option>Spatial-feature MLP</option><option>GNN</option></select></div></div><div class="tablewrap"><table id="resultsTable"><thead><tr><th>Dataset</th><th>Model</th><th>Seed</th><th>MAE</th><th>RMSE</th><th>NMAE</th><th>R²</th></tr></thead><tbody></tbody></table></div></div>
</section>

<section class="page" id="page-validation">
 <div class="grid two">
  <div class="card"><h2>Validation checklist</h2><p class="muted small">Known evidence vs checks that still need source-level confirmation.</p><div id="checks"></div></div>
  <div class="card"><h2>Test protocol</h2><div class="phase"><div class="phase-num">1</div><div><h3>Group by layout</h3><p>Keep the same layout from crossing split boundaries.</p></div></div><div class="phase"><div class="phase-num">2</div><div><h3>Fix the split seed</h3><p>Use split seed 42 for each training seed.</p></div></div><div class="phase"><div class="phase-num">3</div><div><h3>Evaluate held-out test set</h3><p>Compare MAE, RMSE, NMAE and R².</p></div></div><div class="phase"><div class="phase-num">4</div><div><h3>Repeat training</h3><p>Seeds 21, 42 and 123 estimate training-run variability.</p></div></div><div class="note warning" style="margin-top:12px">Three seeds do not establish statistical significance. Report mean ± sample SD and avoid overclaiming.</div></div>
 </div>
 <div class="card" style="margin-top:14px"><div class="section-head"><div><h2>Recorded data audit</h2><p>Summary of known findings from the project notes.</p></div></div><table><thead><tr><th>Check</th><th>Known status</th><th>Research implication</th></tr></thead><tbody><tr><td>Exact duplicate rows</td><td><span class="tag real">Observed in Perth 49</span></td><td>Use grouped splitting and document duplicate handling.</td></tr><tr><td>Same layout, different target</td><td><span class="tag real">Observed</span></td><td>Investigate target variability and missing explanatory variables.</td></tr><tr><td>Power columns as features</td><td><span class="tag real">Leakage risk identified</span></td><td>Exclude individual WEC powers from primary input features.</td></tr><tr><td>NMAE definition</td><td><span class="tag real">Defined in training code</span></td><td>MAE divided by mean absolute held-out test target; scaler fitting is confined to training data.</td></tr><tr><td>Training histories</td><td><span class="tag real">Available · 36/36</span></td><td>Epoch-level histories are stored as separate CSV artifacts, not inside metric JSON exports.</td></tr></tbody></table></div>

 <div class="card" style="margin-top:14px" id="evidenceInspector">
  <div class="section-head"><div><h2>Run-level evidence inspector</h2><p>Loads saved training history and held-out predictions for one dataset, model and seed. Results appear only after metric consistency checks pass.</p></div><span class="pill" id="evidenceStatus">Awaiting selection</span></div>
  <div class="filters" style="margin-bottom:12px"><label class="small muted">Dataset <select class="select" id="evidenceDataset"><option>Perth 49</option><option>Perth 100</option><option>Sydney 49</option><option>Sydney 100</option></select></label><label class="small muted">Model <select class="select" id="evidenceModel"><option>Coordinate MLP</option><option>Spatial-feature MLP</option><option>GNN</option></select></label><label class="small muted">Seed <select class="select" id="evidenceSeed"><option>21</option><option>42</option><option>123</option></select></label><button class="btn primary" id="loadEvidence">Load run evidence</button></div>
  <div class="grid two"><div class="card" style="box-shadow:none"><h3>Training loss (scaled MSE)</h3><p class="small muted">Epoch-by-epoch training history.</p><div id="trainCurve" class="chart"><div class="empty">Load a run to view its history.</div></div></div><div class="card" style="box-shadow:none"><h3>Validation MAE</h3><p class="small muted">Validation-set MAE recorded at each epoch.</p><div id="validationCurve" class="chart"><div class="empty">Load a run to view its history.</div></div></div></div>
  <div class="grid two" style="margin-top:12px"><div class="card" style="box-shadow:none"><h3>Held-out residual distribution</h3><p class="small muted">Residual = actual Total_Power − predicted Total_Power.</p><div id="residualChart" class="chart"><div class="empty">Load a run to view held-out residuals.</div></div><div id="residualSummary" class="small muted"></div></div><div class="card" style="box-shadow:none"><h3>Evidence consistency</h3><div id="runEvidenceChecks" class="small muted">No run selected.</div></div></div>
