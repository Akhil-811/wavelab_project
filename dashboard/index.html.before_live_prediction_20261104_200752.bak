9888182,"R2":0.9717933535575867,"inference_ms_per_sample":0.0561842672623941,"source_file":"results/gnn/WEC_Perth_100_gnn_seed21_metrics.json"}];
const DATASETS=["Perth 49","Perth 100","Sydney 49","Sydney 100"];
const MODELS=["Coordinate MLP","Spatial-feature MLP","GNN"];
const COLORS={"Coordinate MLP":"#6295ff","Spatial-feature MLP":"#45d7e8","GNN":"#b38aff"};
const METRICS={MAE:{label:"MAE",better:"lower"},RMSE:{label:"RMSE",better:"lower"},NMAE:{label:"NMAE",better:"lower"},R2:{label:"R²",better:"higher"}};
const TITLES={overview:["Research overview","Spatially-aware neural surrogate modelling for large-scale wave energy farms."],datasets:["Dataset explorer","Inspect dataset variants, geometry concepts and known data-quality risks."],method:["Methodology & procedure","The end-to-end workflow, split strategy and evidence status."],models:["Model laboratory","Understand the three architectures and compare their aggregate test metrics."],results:["Results & comparison","Explore 36 seeded metric records across datasets, models and metrics."],validation:["Validation & tests","Review data leakage controls, reproducibility and checks still requiring source inspection."],experiments:["Experiment controls","Launch reproducible runs and review persistent experiment history."],conclusions:["Research conclusions","Evidence-backed findings, limitations and recommended next steps."]};
const PHASES=[
["Data acquisition","Obtain the four WEC farm datasets and identify coordinates and total-power target.","Input: four CSV dataset variants. Output: loaded tables.","Recorded project setup; source files not bundled in this dashboard."],
["Data auditing","Inspect missingness, duplicates, repeated layouts and conflicting targets.","Output: data-quality report and leakage checklist.","Perth 49 audit figures are recorded; full audit report should be linked."],
["Grouped splitting","Keep identical layouts within a single split to reduce leakage.","Output: train, validation and test groups using split seed 42.","Grouped split strategy recorded in project notes."],
["Feature engineering","Build coordinate baseline, neighbour-distance descriptors and GNN neighbour edges.","Output: model-specific feature tensors / graph representation.","Architecture notes available; verify exact preprocessing in source."],
["Model training","Train each architecture under reproducible seeds and consistent split.","Output: checkpoints and training histories.","36 seeded metric exports available; full logs are not in the archive."],
["Repeated runs","Repeat training with seeds 21, 42 and 123 while keeping split seed fixed.","Output: variability across three runs.","Verified: 36 seeded result JSON files."],
["Test evaluation","Calculate MAE, RMSE, NMAE and R² on held-out data.","Output: per-seed metric records and aggregates.","Verified from the uploaded metric files."],
["Interpretation","Compare baseline improvements, discuss limitations and plan next experiments.","Output: results narrative and research conclusions.","Conclusions in this dashboard are limited to available metrics."]
];
function fmt(v,metric){if(v==null||!Number.isFinite(v))return "—";if(metric==="NMAE")return v.toFixed(6);if(metric==="R2")return v.toFixed(5);return v.toLocaleString("en-AU",{maximumFractionDigits:1,minimumFractionDigits:1});}
 function aggregate(dataset,model){
  const a=RAW.filter(r=>r.dataset===dataset&&r.model===model);
  const out={};
  ["MAE","RMSE","NMAE","R2","inference_ms_per_sample"].forEach(k=>{
    const vals=a.map(r=>Number(r[k])).filter(Number.isFinite);
    const mean=vals.length?vals.reduce((x,y)=>x+y,0)/vals.length:NaN;
    const sd=vals.length>1?Math.sqrt(vals.reduce((s,v)=>s+(v-mean)**2,0)/(vals.length-1)):NaN;
    out[k]={mean,sd,values:vals};
  });
  return out;
}
function allAgg(){return DATASETS.flatMap(d=>MODELS.map(m=>({dataset:d,model:m,...aggregate(d,m)})));}
 function normalizeDataset(value){
  const s=String(value??"").trim().toLowerCase().replace(/[_-]+/g," ").replace(/\\s+/g," ");
  if(/perth/.test(s)&&/100/.test(s))return "Perth 100";
  if(/perth/.test(s)&&/49/.test(s))return "Perth 49";
  if(/sydney/.test(s)&&/100/.test(s))return "Sydney 100";
  if(/sydney/.test(s)&&/49/.test(s))return "Sydney 49";
  return DATASETS.find(d=>d.toLowerCase()===s)||value;
}
function normalizeModel(value){
  const s=String(value??"").trim().toLowerCase().replace(/[_-]+/g," ").replace(/\\s+/g," ");
  if(["coordinate mlp","mlp","coordinate only mlp","coordinate mlp grouped"].includes(s))return "Coordinate MLP";
  if(["spatial mlp","spatial feature mlp","spatial features mlp"].includes(s))return "Spatial-feature MLP";
  if(["gnn","graph neural network","graph neural network gnn"].includes(s))return "GNN";
  return MODELS.find(m=>m.toLowerCase()===s)||value;
}
async function refreshLiveMetrics({ quiet = true } = {}) {
  try {
    const response = await fetch("/api/metrics", {
      cache: "no-store",
      headers: { Accept: "application/json" }
    });
    if (!response.ok) {
      throw new Error(`Metrics endpoint returned HTTP ${response.status}`);
    }

    const payload = await response.json();
    const records = Array.isArray(payload)
      ? payload
      : payload.metrics || payload.results || payload.records || payload.data;

    if (!Array.isArray(records)) {
      throw new Error("Expected an array or an object containing metrics, results, records, or data.");
    }

    const liveRecords = records.map(r => ({
      ...r,
      dataset: normalizeDataset(r.dataset_label ?? r.dataset ?? r.dataset_name),
      model: normalizeModel(r.model_label ?? r.model ?? r.model_name),
      seed: Number(r.seed ?? r.training_seed),
      MAE: Number(r.MAE ?? r.mae ?? r.test_mae ?? r.test_MAE),
      RMSE: Number(r.RMSE ?? r.rmse ?? r.test_rmse ?? r.test_RMSE),
      NMAE: Number(r.NMAE ?? r.nmae ?? r.test_nmae ?? r.test_NMAE),
      R2: Number(r.R2 ?? r.r2 ?? r.test_r2 ?? r.test_R2),
      inference_ms_per_sample: Number(
        r.inference_ms_per_sample ?? r.test_inference_ms_per_sample ?? r.inference_time_ms_per_sample
      )
    })).filter(r =>
      DATASETS.includes(r.dataset) &&
      MODELS.includes(r.model) &&
      [21, 42, 123].includes(r.seed) &&
      ["MAE", "RMSE", "NMAE", "R2"].every(k => Number.isFinite(r[k]))
    );

    if (!liveRecords.length) {
      throw new Error("No valid metric rows found. Check dataset/model labels, seed values, and metric field names returned by /api/metrics.");
    }

    // Keep only the planned training seeds and one row per dataset/model/seed.
    const unique = new Map();
    liveRecords.forEach(r => unique.set(`${r.dataset}|${r.model}|${r.seed}`, r));
    RAW = Array.from(unique.values());

    renderPhases();
    legend("modelLegend");
    svgBars("overviewMae", "", "MAE", true, true);
    datasetDetails();
    renderSeedChart();
    makeTable();
    improvement();
    renderWinners();
    updateResults();

    const reductions = DATASETS.map(dataset => {
      const baseline = aggregate(dataset, "Coordinate MLP").MAE.mean;
      const best = winner(dataset).MAE.mean;
      return Number.isFinite(baseline) && baseline !== 0 && Number.isFinite(best)
        ? (1 - best / baseline) * 100
        : NaN;
    }).filter(Number.isFinite);

    if (reductions.length) {
      el("bestReduction").textContent = Math.max(...reductions).toFixed(1) + "%";
    }
    if (!quiet) toast(`Loaded ${RAW.length} metric records from backend`);
    console.info(`WaveLab loaded ${RAW.length} live metric records`);
    return true;
  } catch (error) {
    console.error("Live metrics refresh failed; retaining embedded seeded results.", error);
    if (!quiet) toast("Could not load live metrics. Check the browser console.");
    return false;
  }
}
function winner(d,metric="MAE"){let a=MODELS.map(m=>({model:m,...aggregate(d,m)}));return a.sort((x,y)=>metric==="R2"?y[metric].mean-x[metric].mean:x[metric].mean-y[metric].mean)[0];}
function el(id){return document.getElementById(id)}
function svgBars(containerId, dataset, metric, multi=true, error=true){
 const box=el(containerId); if(!box)return;let series=MODELS;let vals=multi?DATASETS.flatMap(d=>series.map(m=>({dataset:d,model:m,a:aggregate(d,m)[metric]}))):series.map(m=>({model:m,a:aggregate(dataset,m)[metric]}));let W=650,H=280,L=70,R=20,T=20,B=48,innerW=W-L-R,innerH=H-T-B;let all=vals.flatMap(v=>v.a.values);let min=metric==="R2"?Math.min(0,Math.min(...all)*.95):0;let max=Math.max(...all)*1.15;if(metric==="R2")max=1; if(!Number.isFinite(max)||max===min)max=min+1;let y=v=>T+innerH-(v-min)/(max-min)*innerH;let xstep=innerW/(multi?DATASETS.length:series.length);let barW=multi?Math.min(24,xstep/(series.length+1)):34;let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${metric} comparison">`;
 for(let i=0;i<=4;i++){let v=min+(max-min)*i/4, yy=y(v);s+=`<line x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}" stroke="#263b51" stroke-width="1"/> <text x="${L-9}" y="${yy+4}" fill="#7892ad" font-size="10" text-anchor="end">${metric==="NMAE"?v.toFixed(4):metric==="R2"?v.toFixed(2):compact(v)}</text>`}
 if(multi){DATASETS.forEach((d,i)=>{let step=innerW/DATASETS.length;MODELS.forEach((m,j)=>{let a=aggregate(d,m)[metric],cx=L+i*step+step/2+(j-1)*(barW+4);let yy=y(a.mean), hh=Math.max(1,T+innerH-yy);s+=`<rect x="${cx-barW/2}" y="${yy}" width="${barW}" height="${hh}" rx="4" fill="${COLORS[m]}" opacity=".92"><title>${d} · ${m}: mean ${fmt(a.mean,metric)}, SD ${fmt(a.sd,metric)}</title></rect>`;if(error&&metric!=="R2"){let top=y(Math.min(max,a.mean+a.sd)),bot=y(Math.max(min,a.mean-a.sd));s+=`<line x1="${cx}" y1="${top}" x2="${cx}" y2="${bot}" stroke="#f3f7fc" stroke-width="1.3"/><line x1="${cx-4}" y1="${top}" x2="${cx+4}" y2="${top}" stroke="#f3f7fc"/><line x1="${cx-4}" y1="${bot}" x2="${cx+4}" y2="${bot}" stroke="#f3f7fc"/>`}});s+=`<text x="${L+i*step+step/2}" y="${H-20}" fill="#a8bfd5" font-size="11" text-anchor="middle">${d}</text>`})}
 else {vals.forEach((v,i)=>{let cx=L+xstep*(i+.5),yy=y(v.a.mean),hh=Math.max(1,T+innerH-yy);s+=`<rect x="${cx-barW/2}" y="${yy}" width="${barW}" height="${hh}" rx="5" fill="${COLORS[v.model]}"><title>${v.model}: mean ${fmt(v.a.mean,metric)}, SD ${fmt(v.a.sd,metric)}</title></rect><text x="${cx}" y="${Math.max(T+10,yy-8)}" fill="#eaf2fb" font-size="10" text-anchor="middle">${fmt(v.a.mean,metric)}</text><text x="${cx}" y="${H-20}" fill="#a8bfd5" font-size="10" text-anchor="middle">${v.model.replace("Spatial-feature ","Spatial ")}</text>`})}
 s+="</svg>";box.innerHTML=s;
}
function compact(n){if(Math.abs(n)>=1000)return (n/1000).toFixed(0)+"k";return n.toFixed(1)}
function legend(id){if(el(id))el(id).innerHTML=MODELS.map(m=>`<span><i class="swatch" style="background:${COLORS[m]}"></i>${m}</span>`).join("")}
function makeTable(){let d=el("tableDataset").value,m=el("tableModel").value;let data=RAW.filter(r=>(d==="all"||r.dataset===d)&&(m==="all"||r.model===m)).sort((a,b)=>DATASETS.indexOf(a.dataset)-DATASETS.indexOf(b.dataset)||MODELS.indexOf(a.model)-MODELS.indexOf(b.model)||a.seed-b.seed);el("resultsTable").querySelector("tbody").innerHTML=data.map(r=>`<tr><td>${r.dataset}</td><td>${r.model}</td><td>${r.seed}</td><td>${fmt(r.MAE,"MAE")}</td><td>${fmt(r.RMSE,"RMSE")}</td><td>${fmt(r.NMAE,"NMAE")}</td><td>${fmt(r.R2,"R2")}</td></tr>`).join("")}
function improvement(){let out=DATASETS.map(d=>{let base=aggregate(d,"Coordinate MLP").MAE.mean;let w=winner(d);let pct=(1-w.MAE.mean/base)*100;return `<div style="padding:12px 0;border-bottom:1px solid #20364d"><div style="display:flex;justify-content:space-between;gap:10px"><b>${d}</b><span class="best">${pct.toFixed(2)}% lower MAE</span></div><div class="small muted">${w.model} · ${fmt(w.MAE.mean,"MAE")} vs baseline ${fmt(base,"MAE")}</div><div class="metricbar"><i style="width:${Math.min(100,Math.max(0,pct*2.2))}%;background:${COLORS[w.model]}"></i></div></div>`}).join("");el("improvement").innerHTML=out}
function renderWinners(){el("winners").innerHTML=DATASETS.map(d=>{let w=winner(d);let base=aggregate(d,"Coordinate MLP").MAE.mean;return `<div class="phase"><div class="phase-num">✓</div><div style="flex:1"><h3>${d} <span class="tag">${w.model}</span></h3><p>Mean MAE ${fmt(w.MAE.mean,"MAE")} ± ${fmt(w.MAE.sd,"MAE")} · R² ${fmt(w.R2.mean,"R2")} · ${((1-w.MAE.mean/base)*100).toFixed(2)}% lower MAE than baseline.</p></div></div>`}).join("");}
function updateModelClaims(){const wins=DATASETS.map(d=>winner(d)),counts=Object.fromEntries(MODELS.map(m=>[m,wins.filter(w=>w.model===m).length])),leader=MODELS.slice().sort((a,b)=>counts[b]-counts[a])[0],gnn=DATASETS.filter(d=>winner(d).model==="GNN");if(el("bestModelPattern"))el("bestModelPattern").textContent=leader==="Spatial-feature MLP"?"Spatial MLP":leader;if(el("bestModelPatternFoot"))el("bestModelPatternFoot").textContent=`Lowest mean MAE on ${counts[leader]} of 4 datasets`;if(el("spatialStrength"))el("spatialStrength").textContent=`Lowest mean MAE on ${counts["Spatial-feature MLP"]} of 4 datasets.`;if(el("gnnStrength"))el("gnnStrength").textContent=gnn.length?`Lowest mean MAE on ${gnn.join(", ")}.`:"Improves over the coordinate baseline; not the lowest mean MAE on these datasets.";const spatial=counts["Spatial-feature MLP"];const phrase=spatial===4?"the spatial-feature MLP has the lowest mean test MAE on all four datasets":`the spatial-feature MLP has the lowest mean test MAE on ${spatial} of four datasets`;const g=gnn.length?` The GNN has the lowest mean test MAE on ${gnn.join(" and ")}.`:" The GNN does not have the lowest mean test MAE on these four datasets.";if(el("conclusionText"))el("conclusionText").textContent=`Across the four evaluated datasets, ${phrase}.${g} These conclusions are limited to the evaluated grouped split and three training seeds; they do not establish statistical significance or generalisation to unseen farms.`;}

function renderPhases(){el("phaseSummary").innerHTML=PHASES.slice(0,4).map((p,i)=>`<div class="phase"><div class="phase-num">${i+1}</div><div><h3>${p[0]}</h3><p>${p[1]}</p></div></div>`).join("");el("timeline").innerHTML=PHASES.map((p,i)=>`<button class="${i===0?"active":""}" data-phase="${i}"><b>PHASE 0${i+1}</b><span>${p[0]}</span></button>`).join("");el("timeline").querySelectorAll("button").forEach(b=>b.onclick=()=>showPhase(+b.dataset.phase));showPhase(0)}
function showPhase(i){document.querySelectorAll("#timeline button").forEach(b=>b.classList.toggle("active",+b.dataset.phase===i));let p=PHASES[i];el("phaseDetail").innerHTML=`<div class="hero" style="padding:18px"><div class="eyebrow">Phase 0${i+1} / 08</div><h2 style="font-size:21px">${p[0]}</h2><p>${p[1]}</p><div class="grid two"><div><div class="mini-title">Expected output</div><p>${p[2]}</p></div><div><div class="mini-title">Evidence status</div><p>${p[3]}</p></div></div><div style="display:flex;gap:8px;margin-top:10px">${i>0?`<button class="btn" onclick="showPhase(${i-1})">← Previous</button>`:""}${i<7?`<button class="btn primary" onclick="showPhase(${i+1})">Next phase →</button>`:""}</div></div>`}
function datasetDetails(){let d=el("datasetSelect").value;let a=MODELS.map(m=>({m,...aggregate(d,m)}));let w=winner(d);el("datasetDetails").innerHTML=`<div class="mini-title">Best mean MAE</div><div style="font-size:25px;font-weight:800;margin:5px 0">${fmt(w.MAE.mean,"MAE")}</div><div class="small muted">${w.model} · sample SD ${fmt(w.MAE.sd,"MAE")}</div><div style="margin-top:15px">${a.map(x=>`<div style="padding:9px 0;border-bottom:1px solid #20364d"><div style="display:flex;justify-content:space-between"><span>${x.m}</span><b>${fmt(x.MAE.mean,"MAE")}</b></div><div class="metricbar"><i style="width:${x.MAE.mean/Math.max(...a.map(y=>y.MAE.mean))*100}%;background:${COLORS[x.m]}"></i></div><div class="small muted">RMSE ${fmt(x.RMSE.mean,"RMSE")} · R² ${fmt(x.R2.mean,"R2")}</div></div>`).join("")}</div>`;drawGeometry()}
function drawGeometry(){let box=el("geometryViz");if(!box)return;let pts=[];for(let i=0;i<30;i++){let x=35+((i*73)%510),y=25+((i*137)%200);pts.push([x,y])}let s='<svg viewBox="0 0 580 250"><rect x="20" y="12" width="540" height="218" rx="12" fill="#091827" stroke="#29435b"/>';pts.forEach((p,i)=>{let near=pts.map((q,j)=>({j,d:(p[0]-q[0])**2+(p[1]-q[1])**2})).filter(v=>v.j!==i).sort((a,b)=>a.d-b.d).slice(0,2);near.forEach(n=>{let q=pts[n.j];s+=`<line x1="${p[0]}" y1="${p[1]}" x2="${q[0]}" y2="${q[1]}" stroke="#3e7594" opacity=".35"/>`})});pts.forEach((p,i)=>s+=`<circle cx="${p[0]}" cy="${p[1]}" r="4" fill="${i%4===0?"#45d7e8":"#6295ff"}" stroke="#0b1b2c" stroke-width="1"/>`);s+="</svg>";box.innerHTML=s}
function renderSeedChart(){let d=el("seedDataset").value,m=el("seedModel").value;let rs=RAW.filter(r=>r.dataset===d&&r.model===m).sort((a,b)=>a.seed-b.seed);let W=500,H=220,L=60,R=18,T=20,B=40,vals=rs.map(r=>r.MAE),mn=Math.min(...vals)*.93,mx=Math.max(...vals)*1.04,y=v=>T+(H-T-B)-(v-mn)/(mx-mn)*(H-T-B);let s=`<svg viewBox="0 0 ${W} ${H}">`;for(let i=0;i<4;i++){let v=mn+(mx-mn)*i/3,yy=y(v);s+=`<line x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}" stroke="#263b51"/><text x="${L-8}" y="${yy+4}" text-anchor="end" fill="#829bb5" font-size="10">${compact(v)}</text>`}rs.forEach((r,i)=>{let x=L+(i+.5)*(W-L-R)/rs.length,yy=y(r.MAE);s+=`<circle cx="${x}" cy="${yy}" r="6" fill="${COLORS[m]}"><title>Seed ${r.seed}: MAE ${fmt(r.MAE,"MAE")}</title></circle><text x="${x}" y="${H-14}" text-anchor="middle" fill="#a8bfd5" font-size="11">Seed ${r.seed}</text><text x="${x}" y="${yy-12}" text-anchor="middle" fill="#eaf2fb" font-size="10">${compact(r.MAE)}</text>`});s+="</svg>";el("seedChart").innerHTML=s}
function updateResults(){svgBars("resultChart",el("resultDataset").value,el("resultMetric").value,true,true);legend("resultLegend");svgBars("modelChart",el("modelDataset").value,el("modelMetric").value,false,false);renderSeedChart()}
function toast(t){el("toast").textContent=t;el("toast").style.display="block";setTimeout(()=>el("toast").style.display="none",2500)}
function go(page){document.querySelectorAll(".page").forEach(p=>p.classList.toggle("active",p.id==="page-"+page));document.querySelectorAll(".nav").forEach(n=>n.classList.toggle("active",n.dataset.page===page));el("pageTitle").textContent=TITLES[page][0];el("pageSub").textContent=TITLES[page][1];window.scrollTo({top:0,behavior:"smooth"});if(page==="results")updateResults()}
document.querySelectorAll(".nav").forEach(n=>n.addEventListener("click",()=>go(n.dataset.page)));
["resultDataset","resultMetric","modelDataset","modelMetric","seedDataset","seedModel"].forEach(id=>el(id).addEventListener("change",updateResults));
el("datasetSelect").addEventListener("change",datasetDetails);["evidenceDataset","evidenceModel","evidenceSeed"].forEach(id=>el(id).addEventListener("change",()=>{el("evidenceStatus").textContent="Selection changed · load evidence";}));
["tableDataset","tableModel"].forEach(id=>el(id).addEventListener("change",makeTable));
function exportCSV(){let headers=["dataset","model","seed","MAE","RMSE","NMAE","R2","inference_ms_per_sample","source_file"];let rows=[headers.join(","),...RAW.map(r=>headers.map(h=>JSON.stringify(r[h]??"")).join(","))];download("wave_energy_seed_metrics.csv",rows.join("\n"),"text/csv")}
function download(name,content,type){let blob=new Blob([content],{type});let a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=name;a.click();URL.revokeObjectURL(a.href)}
el("exportCsv").onclick=exportCSV;
function buildConfig(){let seed=el("runSeed").value==="Custom"?Number(el("customSeed").value):Number(el("runSeed").value);let cfg={dataset:el("runDataset").value,model:el("runModel").value,training_seed:seed,split_seed:Number(el("splitSeed").value),epochs:Number(el("epochs").value),notes:el("runNotes").value,inputs_policy:{coordinate_only_and_spatial_only:true,exclude_individual_power_columns:true,exclude_qW:true},execution_status:"configuration_only_backend_not_connected",requested_at:new Date().toISOString()};el("configPreview").textContent=JSON.stringify(cfg,null,2);el("runStatus").textContent="Configuration built. No training process has started. Download the JSON and connect it to the local project backend.";el("runProgress").style.width="12%";window.currentConfig=cfg;return cfg}
el("buildConfig").onclick=()=>{buildConfig();toast("Run configuration built")};
el("downloadConfig").onclick=()=>{let c=window.currentConfig||buildConfig();download("wave_energy_run_config.json",JSON.stringify(c,null,2),"application/json");toast("Configuration downloaded")};
el("copyConfig").onclick=()=>{let c=window.currentConfig||buildConfig();navigator.clipboard?.writeText(JSON.stringify(c,null,2)).then(()=>toast("Configuration copied")).catch(()=>toast("Use Download JSON if clipboard is unavailable"))};
function escapeHtml(value){return String(value??"").replace(/[&<>"']/g,ch=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]))}
function displayMetric(value){const n=Number(value);return Number.isFinite(n)?n.toLocaleString("en-AU",{maximumFractionDigits:2}):"—"}
async function refreshRunHistory({quiet=true}={}){
 const status=el("runHistoryStatus"), body=el("runHistoryTable")?.querySelector("tbody");
 if(!body)return;
 try{
  const response=await fetch("/api/runs",{cache:"no-store",headers:{"Accept":"application/json"}});
  if(!response.ok)throw new Error(`HTTP ${response.status}`);
  const payload=await response.json();
  if(!Array.isArray(payload))throw new Error("Run history response was not a list");
  const runs=payload.slice().reverse();
  if(!runs.length){body.innerHTML='<tr><td colspan="8" class="muted">No new experiments recorded yet. Launch an experiment to create the first history entry.</td></tr>';status.textContent="Run history is connected. No runs have been recorded.";return true}
  body.innerHTML=runs.map(run=>{
   const metrics=Array.isArray(run.metrics)?run.metrics:[];
   const mae=metrics.length?metrics.map(m=>`${escapeHtml(m.model)}: ${displayMetric(m.MAE)}`).join("<br>"):"—";
   const rmse=metrics.length?metrics.map(m=>`${escapeHtml(m.model)}: ${displayMetric(m.RMSE)}`).join("<br>"):"—";
   const artifacts=[run.log_file,...(run.checkpoint_paths||[]),...metrics.map(m=>m.result_file)].filter(Boolean);
   const artifactText=artifacts.length?artifacts.map(x=>`<div>${escapeHtml(x)}</div>`).join(""):"—";
   const started=run.started_at?new Date(run.started_at).toLocaleString("en-AU"):"—";
   const state=run.status==="completed"?`<span class="tag real">Completed · exit ${escapeHtml(run.returncode)}</span>`:run.status==="failed"?`<span class="tag todo">Failed · exit ${escapeHtml(run.returncode)}</span>`:`<span class="tag">${escapeHtml(run.status||"unknown")}</span>`;
   return `<tr><td>${escapeHtml(started)}<div class="small muted">Run ${escapeHtml(run.run_id)}</div>${run.notes?`<div class="small muted">${escapeHtml(run.notes)}</div>`:""}</td><td>${escapeHtml(run.dataset||"—")}</td><td>${escapeHtml(run.model||"—")}</td><td>${escapeHtml(run.training_seed??"—")} / ${escapeHtml(run.split_seed??"—")}</td><td>${state}</td><td>${mae}</td><td>${rmse}</td><td class="small">${artifactText}</td></tr>`;
  }).join("");
  status.textContent=`${runs.length} saved run${runs.length===1?"":"s"}. Original benchmark records are kept separately.`;
  return true;
 }catch(error){status.textContent="Could not load run history from /api/runs. Check that the updated server.py is running. "+error.message;body.innerHTML='<tr><td colspan="8" class="muted">Run history API unavailable.</td></tr>';return false}
}
el("refreshRunHistory").onclick=()=>refreshRunHistory({quiet:false}).then(ok=>{if(ok)toast("Run history refreshed")});
 el("launchRun").onclick=async()=>{
  const c=window.currentConfig||buildConfig();
  el("runStatus").textContent="Checking the local WaveLab backend…";
  try{
    const r=await fetch("/api/experiments",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify(c)});
    const data=await r.json().catch(()=>({}));
    if(!r.ok)throw new Error(data.error||`HTTP ${r.status}`);
    el("runStatus").textContent="Experiment accepted by the local backend. Run ID: "+(data.run_id||"assigned")+". Live output will appear below.";
    el("backendPill").textContent="Connected";el("runProgress").style.width="20%";toast("Experiment launched");refreshRunHistory();pollBackend();
  }catch(e){
    el("backendPill").textContent="Disconnected";el("runProgress").style.width="0%";
    el("runStatus").textContent="Backend not connected. No training was started. Start the WaveLab Python server and open this dashboard through http://127.0.0.1:8765, then try again. Details: "+e.message;
    toast("Backend not connected");
  }
};
let backendPollTimer=null;
async function pollBackend(){
  if(backendPollTimer){clearTimeout(backendPollTimer);backendPollTimer=null;}
  try{
    const r=await fetch("/api/status",{cache:"no-store",headers:{"Accept":"application/json"}});
    if(!r.ok)throw new Error(`HTTP ${r.status}`);
    const s=await r.json();
    const connected=s.connected===true||s.backend_connected===true||s.status==="ok"||s.status==="connected"||s.running===true||Boolean(s.config||s.last_run||s.returncode!==undefined);
    setBackendIndicators(connected, connected ? "Local backend connected" : "Backend not connected");
    el("backendPill").textContent=connected?"Connected":"Disconnected";
    if(s.running){
      el("runStatus").textContent="Training process is running. Started: "+(s.started_at||"time not reported");
      el("runProgress").style.width="65%";el("configPreview").textContent=(s.log||"Waiting for Python output…").slice(-6500);
      backendPollTimer=setTimeout(pollBackend,1800);
    }else if(s.last_run){
      const code=s.last_run.returncode??s.returncode;
      const runState=s.last_run.status||"unknown";
      const log=(s.log||"").trim();
      if(runState==="completed" && code===0){
        el("runStatus").textContent="Most recent experiment completed successfully (exit code 0). Run ID: "+(s.last_run.run_id||"not recorded")+".";
        el("runProgress").style.width="100%";
        if(log)el("configPreview").textContent=log.slice(-6500);
        else el("configPreview").textContent="The run completed successfully. No log file is available for this historical run.";
      }else if(runState==="failed" || (code!==null && code!==undefined && code!==0)){
        el("runStatus").textContent="Most recent experiment failed (exit code "+(code??"not recorded")+"). Run ID: "+(s.last_run.run_id||"not recorded")+".";
        el("runProgress").style.width="0%";
        el("configPreview").textContent=log?log.slice(-6500):"The run is recorded as failed, but no log file is available.";
      }else{
        el("runStatus").textContent="Backend connected. Latest saved run status: "+runState+".";
        el("configPreview").textContent=log?log.slice(-6500):"No log file is available for the latest saved run.";
      }
      if(runState==="completed" && code===0)refreshLiveMetrics({quiet:true});
      refreshRunHistory();
    }else{
      el("runStatus").textContent="Backend connected. No experiment has been submitted.";
      el("configPreview").textContent="Backend ready. Configure a run and click Launch experiment.";
    }
  }catch(e){
    setBackendIndicators(false, "Backend not reachable. Open via http://127.0.0.1:8765");
    el("backendPill").textContent="Disconnected";
    if(!window.currentConfig)el("runStatus").textContent="Backend status check failed: "+e.message+". Embedded research results remain available. Confirm the WaveLab Python server is running and open this page through http://127.0.0.1:8765.";
  }
}
function setBackendIndicators(connected, message){
  const hero=el("heroBackendPill"), side=el("sidebarBackendText"), title=el("sidebarStatusTitle"), dot=el("sidebarStatusDot");
  if(hero){hero.textContent=connected?"Backend connected":"Backend not connected";hero.style.color=connected?"#85efc5":"#ffd39a";}
  if(side)side.textContent=message;
  if(title)title.textContent=connected?"Results loaded · backend online":"Results loaded · offline mode";
  if(dot)dot.style.background=connected?"var(--green)":"var(--orange)";
}

el("copyConclusion").onclick=()=>{navigator.clipboard?.writeText(el("conclusionText").textContent).then(()=>toast("Conclusion copied")).catch(()=>toast("Clipboard unavailable"))};
async function refreshEvidenceChecklist(){
 const rows=[["Seeded metrics","metrics"],["Fixed split seed","split"],["Grouped layout split","grouped"],["Leakage prevention","leakage"],["Training curves","histories"],["Prediction residuals","predictions"],["Backend execution","backend"],["NMAE normalization","nmae"]];
 try{const r=await fetch("/api/health",{cache:"no-store"});if(!r.ok)throw new Error("Health endpoint HTTP "+r.status);const h=await r.json(),c=h.checks||{};
 el("checks").innerHTML=rows.map(([label,key])=>{const ok=!!c[key]?.ok;return `<div class="phase"><div class="phase-num">${ok?"✓":"!"}</div><div><h3>${label} <span class="tag ${ok?"real":"todo"}">${ok?"Verified":"Needs attention"}</span></h3><p>${c[key]?.detail||"Not verified"}</p></div></div>`}).join("");
 }catch(e){el("checks").innerHTML=`<div class="note warning">Could not verify evidence through the local backend: ${String(e.message||e)}. Open WaveLab through python server.py and refresh.</div>`;}
}
function drawLineChart(id,rows,key,label){const box=el(id),v=rows.map(r=>Number(r[key])).filter(Number.isFinite);if(v.length<2){box.innerHTML='<div class="empty">Insufficient epoch data.</div>';return;}const W=620,H=240,L=62,R=18,T=16,B=36,lo=Math.min(...v),hi=Math.max(...v),span=hi-lo||1,x=i=>L+i*(W-L-R)/(v.length-1),y=n=>T+(H-T-B)-(n-lo)/span*(H-T-B);let z=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${label}">`;for(let i=0;i<=4;i++){let n=lo+span*i/4,yy=y(n);z+=`<line x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}" stroke="#263b51"/><text x="${L-8}" y="${yy+4}" text-anchor="end" fill="#829bb5" font-size="10">${n.toLocaleString("en-AU",{maximumFractionDigits:3})}</text>`;}z+=`<polyline fill="none" stroke="#45d7e8" stroke-width="2.5" points="${v.map((n,i)=>`${x(i)},${y(n)}`).join(" ")}"/><text x="${L}" y="${H-9}" fill="#a8bfd5" font-size="10">Epoch 1</text><text x="${W-R}" y="${H-9}" text-anchor="end" fill="#a8bfd5" font-size="10">Epoch ${v.length}</text></svg>`;box.innerHTML=z;}
function drawResidualHistogram(bins){const box=el("residualChart"),W=620,H=240,L=58,R=18,T=16,B=38,mx=Math.max(...bins.map(b=>b.count),1),step=(W-L-R)/bins.length,bw=step*.82;let z=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Held-out residual histogram">`;for(let i=0;i<=4;i++){let yy=T+(H-T-B)*i/4;z+=`<line x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}" stroke="#263b51"/>`;}bins.forEach((b,i)=>{let hh=b.count/mx*(H-T-B),xx=L+i*step+(step-bw)/2;z+=`<rect x="${xx}" y="${H-B-hh}" width="${bw}" height="${hh}" rx="2" fill="#b38aff"><title>${b.label}: ${b.count}</title></rect>`;});z+=`<text x="${L}" y="${H-9}" fill="#a8bfd5" font-size="10">${bins[0].label}</text><text x="${W-R}" y="${H-9}" text-anchor="end" fill="#a8bfd5" font-size="10">${bins[bins.length-1].label}</text></svg>`;box.innerHTML=z;}
async function loadRunEvidence(){const d=el("evidenceDataset").value,m=el("evidenceModel").value,seed=el("evidenceSeed").value;el("evidenceStatus").textContent="Loading…";try{const q=new URLSearchParams({dataset:d,model:m,seed}),r=await fetch("/api/artifacts?"+q.toString(),{cache:"no-store"}),a=await r.json();if(!r.ok||!a.verified)throw new Error(a.message||a.error||`HTTP ${r.status}`);drawLineChart("trainCurve",a.history,"train_mse_scaled","Training scaled MSE");drawLineChart("validationCurve",a.history,"validation_mae","Validation MAE");drawResidualHistogram(a.residual_histogram);const x=a.residual_summary;el("residualSummary").textContent=`n=${x.count.toLocaleString()} · MAE ${x.mae.toLocaleString("en-AU",{maximumFractionDigits:2})} · RMSE ${x.rmse.toLocaleString("en-AU",{maximumFractionDigits:2})} · mean residual ${x.mean_residual.toLocaleString("en-AU",{maximumFractionDigits:2})}`;el("runEvidenceChecks").innerHTML=`<p>✓ Saved metric JSON reproduced from predictions (MAE, RMSE, NMAE and R²).</p><p>✓ ${a.history.length} epoch records.</p><p>✓ ${x.count.toLocaleString()} held-out predictions.</p><p class="small muted">Metric: ${a.metric_file}<br>History: ${a.history_file}<br>Predictions: ${a.predictions_file}</p>`;el("evidenceStatus").textContent="Run evidence verified";el("evidenceStatus").style.color="#85efc5";}catch(e){el("evidenceStatus").textContent="Evidence unavailable";el("runEvidenceChecks").innerHTML=`<div class="note warning">${String(e.message||e)}</div>`;}}

setBackendIndicators(false, "Checking local backend…");refreshEvidenceChecklist();el("loadEvidence").addEventListener("click",loadRunEvidence);renderPhases();pollBackend();refreshRunHistory();legend("modelLegend");svgBars("overviewMae","", "MAE",true,true);datasetDetails();renderSeedChart();makeTable();improvement();renderWinners();updateModelClaims();refreshLiveMetrics({quiet:true});
let bestPct=Math.max(...DATASETS.map(d=>(1-winner(d).MAE.mean/aggregate(d,"Coordinate MLP").MAE.mean)*100));el("bestReduction").textContent=bestPct.toFixed(1)+"%";
updateModelClaims();
</script></body></html>